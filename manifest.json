{
  "manifest_version": 3,
  "name": "Tumblr Post to EPUB",
  "version": "0.1.2",
  "description": "Export individual Tumblr posts as self-contained EPUB files for private archiving.",
  "author": "linumlea",
  "homepage_url": "https://github.com/linumlea/tumblr-post-to-epub",
  "icons": {
    "16": "icons/icon.svg",
    "32": "icons/icon.svg",
    "48": "icons/icon.svg",
    "96": "icons/icon.svg",
    "128": "icons/icon.svg"
  },
  "action": {
    "default_title": "Export Tumblr post as EPUB",
    "default_popup": "src/popup/index.html",
    "default_icon": {
      "16": "icons/icon.svg",
      "32": "icons/icon.svg",
      "48": "icons/icon.svg"
    }
  },
  "background": {
    "scripts": ["background/index.js"],
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://*.tumblr.com/*"],
      "js": ["content/index.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": ["activeTab", "downloads", "scripting"],
  "host_permissions": ["https://*.tumblr.com/*", "https://*.media.tumblr.com/*", "https://*.tumblr.co/*"],
  "browser_specific_settings": {
    "gecko": {
      "id": "tumblr-post-to-epub@linumlea.github.io",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
